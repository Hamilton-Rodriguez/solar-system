apiVersion: v1
kind: Config
preferences: {}

# 1. WHERE IS THE CLUSTER?
clusters:
- name: my-study-cluster
  cluster:
    server: https://your-ec2-public-ip:6443 # The public API address of your cluster
    certificate-authority-data: LS0tLS1CRUdJTiBDRVJUS... # Base64-encoded server CA cert

# 2. WHO ARE YOU?
users:
- name: cluster-admin
  user:
    client-certificate-data: LS0tLS1CRUdJTiBDRVJUS... # Base64-encoded client certificate
    client-key-data: LS0tLS1CRUdJTiBQUklWQVRFIEtFW... # Base64-encoded client private key

# 3. MATCHING CLUSTER + USER
contexts:
- name: admin-context
  context:
    cluster: my-study-cluster
    user: cluster-admin

# 4. DEFAULT CONTEXT
current-context: admin-context